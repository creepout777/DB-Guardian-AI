# DB-Guardian AI Environment Variables Template
# Copy this file to .env.local for local development.
# In Vite, all client-exposed variables MUST start with VITE_

# API Gateway Base URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Cloud Identity & Authentication (Supabase / AWS Cognito / OIDC)
VITE_CLOUD_AUTH_PROVIDER=supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# LLM Engine Credentials (Used server-side or via API gateway)
VITE_LLM_PROVIDER=openai
VITE_DEFAULT_MODEL=gpt-4o

# Environment Mode
VITE_APP_ENV=production
