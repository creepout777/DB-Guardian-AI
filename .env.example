# DB-Guardian AI Environment Variables Template
# Copy this file to .env.local for local development.
# In Vite, all client-exposed variables MUST start with VITE_

# API Gateway Base URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Supabase Public Keys (Used by React Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Direct Database URL (Used by Vercel Build Pipeline for Auto-Migrations)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Environment Mode
VITE_APP_ENV=production
