# DB-Guardian AI Environment Variables Template
# Copy this file to .env.local for local development.
# .env.local is git-ignored and must never be committed.
# In Vite, only variables prefixed with VITE_ are bundled into browser code.

# -----------------------------------------------------------------------
# SUPABASE PUBLIC KEYS (Required for local development and Vercel)
# Get these from: Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# -----------------------------------------------------------------------
# OPTIONAL FUTURE KEYS (add new variables below with a comment)
# When adding a new key, document what it does and where to find the value.
# -----------------------------------------------------------------------

# Example (remove this line when adding real variables):
# VITE_OPENAI_API_KEY=your-openai-key-here
